{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "type": {
      "type": "string",
      "enum": [
        "income",
        "expense"
      ]
    },
    "category": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "default": "CAD"
    },
    "client": {
      "type": "string"
    },
    "product": {
      "type": "string"
    },
    "import_id": {
      "type": "string"
    }
  },
  "required": [
    "date",
    "amount",
    "type"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}