{
  "name": "Event",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "lancement_produit",
        "promotion",
        "changement_prix",
        "nouveau_fournisseur",
        "depart_employe",
        "campagne_marketing",
        "probleme_logistique",
        "changement_reglementaire",
        "embauche",
        "fermeture",
        "expansion"
      ]
    },
    "description": {
      "type": "string"
    },
    "impact_area": {
      "type": "string"
    }
  },
  "required": [
    "date",
    "event_type"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}