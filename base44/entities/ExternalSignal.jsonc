{
  "name": "ExternalSignal",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "subdomain": {
      "type": "string"
    },
    "family": {
      "type": "string",
      "enum": [
        "market",
        "competitors",
        "commercial",
        "tech",
        "economy",
        "legal",
        "territory_resources",
        "ecosystem",
        "gouvernement",
        "economie",
        "marche",
        "concurrence",
        "fournisseurs",
        "consommateurs",
        "actualites"
      ]
    },
    "entity_name": {
      "type": "string"
    },
    "event": {
      "type": "string"
    },
    "relevance_score": {
      "type": "number"
    },
    "confidence": {
      "type": "number"
    },
    "impact": {
      "type": "string",
      "enum": [
        "positif",
        "neutre",
        "negatif"
      ]
    },
    "source": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "location": {
      "type": "string"
    },
    "fact": {
      "type": "string"
    },
    "inference": {
      "type": "string"
    },
    "monitoring_tip": {
      "type": "string"
    },
    "relevance_reason": {
      "type": "string"
    },
    "recommended_action": {
      "type": "string"
    },
    "affected_kpis": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "nouveau",
        "vu",
        "archive"
      ],
      "default": "nouveau"
    },
    "import_id": {
      "type": "string"
    },
    "original_data": {
      "type": "string",
      "description": "Ligne du fichier source telle quelle (JSON), toutes colonnes comprises. Permet de retrouver une valeur non reconnue ou repliee sans reimporter."
    },
    "fingerprint": {
      "type": "string",
      "description": "Empreinte metier de la ligne, utilisee pour detecter les doublons entre imports."
    }
  },
  "required": [
    "title",
    "family"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}