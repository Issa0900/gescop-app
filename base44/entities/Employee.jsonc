{
  "name": "Employee",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "department": {
      "type": "string",
      "enum": [
        "direction",
        "ventes",
        "marketing",
        "logistique",
        "administration",
        "service_client",
        "atelier",
        "autre"
      ]
    },
    "role": {
      "type": "string"
    },
    "hire_date": {
      "type": "string",
      "format": "date"
    },
    "employment_type": {
      "type": "string",
      "enum": [
        "temps_plein",
        "temps_partiel",
        "contractuel",
        "stagiaire"
      ]
    },
    "hourly_rate": {
      "type": "number"
    },
    "weekly_hours": {
      "type": "number"
    },
    "full_name": {
      "type": "string"
    },
    "annual_salary": {
      "type": "number"
    },
    "salary": {
      "type": "number"
    },
    "branch": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "actif",
        "depart",
        "conge",
        "essai"
      ]
    },
    "employer_cost": {
      "type": "number",
      "description": "Cout employeur annuel : salaire + charges sociales patronales."
    },
    "social_charges": {
      "type": "number",
      "description": "Charges sociales patronales annuelles (RRQ, RQAP, CNESST, FSS...)."
    },
    "union_status": {
      "type": "string"
    },
    "import_id": {
      "type": "string"
    },
    "original_data": {
      "type": "string",
      "description": "Ligne du fichier source telle quelle (JSON), toutes colonnes comprises. Permet de retrouver une valeur non reconnue ou repliee sans reimporter."
    },
    "fingerprint": {
      "type": "string",
      "description": "Empreinte metier de la ligne, utilisee pour detecter les doublons entre imports."
    }
  },
  "required": [
    "employee_id"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
