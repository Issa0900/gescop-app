{
  "name": "Asset",
  "type": "object",
  "properties": {
    "asset_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "acquisition_date": {
      "type": "string",
      "format": "date"
    },
    "dpa_class": {
      "type": "string"
    },
    "dpa_rate": {
      "type": "number"
    },
    "initial_cost": {
      "type": "number"
    },
    "accumulated_depreciation": {
      "type": "number"
    },
    "net_book_value": {
      "type": "number"
    },
    "location_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "description": "Categorie de l'actif (vehicule, equipement, amenagement...)."
    },
    "useful_life_years": {
      "type": "number",
      "description": "Duree de vie utile, en annees."
    },
    "residual_value": {
      "type": "number",
      "description": "Valeur residuelle en fin de vie."
    },
    "depreciation_method": {
      "type": "string",
      "description": "Methode d'amortissement (lineaire, degressif...)."
    },
    "historical_comment": {
      "type": "string"
    },
    "import_id": {
      "type": "string"
    },
    "fingerprint": {
      "type": "string"
    },
    "original_data": {
      "type": "string"
    }
  },
  "required": [
    "asset_id"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
