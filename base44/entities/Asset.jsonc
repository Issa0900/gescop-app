{
  "name": "Asset",
  "type": "object",
  "description": "Immobilisation (registre des actifs) : cout, amortissement cumule, valeur nette comptable.",
  "properties": {
    "asset_id": {
      "type": "string"
    },
    "asset_name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "acquisition_date": {
      "type": "string",
      "format": "date"
    },
    "cca_class": {
      "type": "string"
    },
    "cca_rate": {
      "type": "number"
    },
    "acquisition_cost": {
      "type": "number"
    },
    "accumulated_depreciation": {
      "type": "number"
    },
    "net_book_value": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "import_id": {
      "type": "string"
    },
    "original_data": {
      "type": "string",
      "description": "Ligne du fichier source telle quelle (JSON), toutes colonnes comprises. Permet de retrouver une valeur non reconnue ou repliee sans reimporter."
    },
    "fingerprint": {
      "type": "string",
      "description": "Empreinte metier de la ligne, utilisee pour detecter les doublons entre imports."
    }
  },
  "required": [
    "asset_id"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
