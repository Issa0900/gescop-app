{
  "name": "Inventory",
  "type": "object",
  "properties": {
    "inventory_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "product_id": {
      "type": "string"
    },
    "opening_stock": {
      "type": "number"
    },
    "purchases": {
      "type": "number"
    },
    "units_sold": {
      "type": "number"
    },
    "returns": {
      "type": "number"
    },
    "damaged": {
      "type": "number"
    },
    "closing_stock": {
      "type": "number"
    },
    "inventory_value": {
      "type": "number"
    },
    "days_in_inventory": {
      "type": "number"
    },
    "unit_cost": {
      "type": "number"
    },
    "selling_price": {
      "type": "number"
    },
    "product_name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "stock_status": {
      "type": "string",
      "enum": [
        "optimal",
        "rupture",
        "surstock",
        "dormant",
        "faible",
        "proche_rupture"
      ]
    },
    "import_id": {
      "type": "string"
    },
    "original_data": {
      "type": "string",
      "description": "Ligne du fichier source telle quelle (JSON), toutes colonnes comprises. Permet de retrouver une valeur non reconnue ou repliee sans reimporter."
    },
    "fingerprint": {
      "type": "string",
      "description": "Empreinte metier de la ligne, utilisee pour detecter les doublons entre imports."
    }
  },
  "required": [
    "product_id"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}