{
  "name": "Inventory",
  "type": "object",
  "properties": {
    "inventory_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "import_date": {
      "type": "string",
      "format": "date",
      "description": "Date a laquelle GESCOP a recu ces donnees. Jamais la date de l'inventaire."
    },
    "reference_date": {
      "type": "string",
      "format": "date",
      "description": "Date de reference pour l'affichage operationnel : la date d'inventaire si le fichier la donne, sinon la date d'import (voir reference_date_type)."
    },
    "reference_date_type": {
      "type": "string",
      "enum": [
        "INVENTORY_DATE",
        "IMPORT_DATE"
      ],
      "description": "INVENTORY_DATE : date reelle de l'inventaire. IMPORT_DATE : date reelle inconnue, la date d'import sert de reference technique."
    },
    "product_id": {
      "type": "string"
    },
    "opening_stock": {
      "type": "number"
    },
    "purchases": {
      "type": "number"
    },
    "units_sold": {
      "type": "number"
    },
    "returns": {
      "type": "number"
    },
    "damaged": {
      "type": "number"
    },
    "closing_stock": {
      "type": "number"
    },
    "qte_en_stock": {
      "type": "number"
    },
    "inventory_level": {
      "type": "number"
    },
    "available_qty": {
      "type": "number"
    },
    "quantite_disponible": {
      "type": "number"
    },
    "inventory_value": {
      "type": "number"
    },
    "selling_inventory_value": {
      "type": "number"
    },
    "valeur_stock_vente": {
      "type": "number"
    },
    "days_in_inventory": {
      "type": "number"
    },
    "unit_cost": {
      "type": "number"
    },
    "selling_price": {
      "type": "number"
    },
    "product_name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "stock_status": {
      "type": "string",
      "enum": [
        "optimal",
        "rupture",
        "surstock",
        "dormant",
        "faible",
        "proche_rupture"
      ]
    },
    "warehouse_id": {
      "type": "string"
    },
    "warehouse_name": {
      "type": "string"
    },
    "reserved_qty": {
      "type": "number"
    },
    "in_transit_qty": {
      "type": "number"
    },
    "reorder_qty_eoq": {
      "type": "number"
    },
    "reorder_point": {
      "type": "number"
    },
    "origin_country": {
      "type": "string"
    },
    "customs_code": {
      "type": "string"
    },
    "supplier_id": {
      "type": "string"
    },
    "supplier_name": {
      "type": "string"
    },
    "quantity_available": {
      "type": "number"
    },
    "sale_value": {
      "type": "number",
      "description": "Valeur du stock au prix de vente (inventory_value reste la valeur au cout)."
    },
    "import_id": {
      "type": "string"
    },
    "original_data": {
      "type": "string",
      "description": "Ligne du fichier source telle quelle (JSON), toutes colonnes comprises. Permet de retrouver une valeur non reconnue ou repliee sans reimporter."
    },
    "fingerprint": {
      "type": "string",
      "description": "Empreinte metier de la ligne, utilisee pour detecter les doublons entre imports."
    }
  },
  "required": [
    "product_id"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
