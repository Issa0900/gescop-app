{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "privacy_consent_accepted": {
      "type": "boolean",
      "description": "Whether the user accepted the Loi 25 privacy policy"
    },
    "privacy_consent_date": {
      "type": "string",
      "description": "ISO timestamp of when the user accepted the privacy policy"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object",
  "rls": {
    "read": {
      "id": "{{user.id}}"
    },
    "update": {
      "id": "{{user.id}}"
    }
  }
}