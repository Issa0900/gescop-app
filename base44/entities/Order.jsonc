{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "channel": {
      "type": "string",
      "enum": [
        "shopify",
        "boutique",
        "b2b",
        "instagram",
        "web",
        "en_ligne",
        "magasin",
        "autre"
      ]
    },
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "quantity": {
      "type": "number"
    },
    "price": {
      "type": "number"
    },
    "unit_price": {
      "type": "number"
    },
    "subtotal": {
      "type": "number"
    },
    "discount": {
      "type": "number"
    },
    "tax": {
      "type": "number"
    },
    "shipping": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "cost": {
      "type": "number"
    },
    "total_revenue": {
      "type": "number"
    },
    "total_cost": {
      "type": "number"
    },
    "unit_cost": {
      "type": "number"
    },
    "gross_margin": {
      "type": "number"
    },
    "gross_profit": {
      "type": "number"
    },
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "payment_method": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "paye",
        "en_attente",
        "echoue",
        "rembourse"
      ]
    },
    "fulfillment_status": {
      "type": "string",
      "enum": [
        "expedie",
        "en_preparation",
        "livre",
        "annule",
        "retourne"
      ]
    },
    "return_status": {
      "type": "string",
      "enum": [
        "aucun",
        "demande",
        "approuve",
        "refuse"
      ]
    },
    "region": {
      "type": "string"
    },
    "province": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "tax_federal": {
      "type": "number"
    },
    "tax_provincial": {
      "type": "number"
    },
    "location_id": {
      "type": "string"
    },
    "succursale": {
      "type": "string"
    },
    "store": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "order_value": {
      "type": "number"
    },
    "segment": {
      "type": "string"
    },
    "customer_segment": {
      "type": "string"
    },
    "age": {
      "type": "number"
    },
    "signup_date": {
      "type": "string",
      "format": "date"
    },
    "line_id": {
      "type": "string",
      "description": "Identifiant de la ligne dans le fichier source (Transaction_ID, ID_Ligne, Row ID) : distingue deux articles d'une meme commande."
    },
    "currency": {
      "type": "string",
      "description": "Devise de la vente (code ISO : CAD, USD, EUR...), lue dans le fichier ou deduite du pays. Les montants restent dans cette devise."
    },
    "import_id": {
      "type": "string"
    },
    "original_data": {
      "type": "string",
      "description": "Ligne du fichier source telle quelle (JSON), toutes colonnes comprises. Permet de retrouver une valeur non reconnue ou repliee sans reimporter."
    },
    "fingerprint": {
      "type": "string",
      "description": "Empreinte metier de la ligne, utilisee pour detecter les doublons entre imports."
    }
  },
  "required": [
    "order_id",
    "date"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
