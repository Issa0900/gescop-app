{
  "name": "Payroll",
  "type": "object",
  "properties": {
    "payroll_id": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "hours": {
      "type": "number"
    },
    "regular_pay": {
      "type": "number"
    },
    "overtime": {
      "type": "number"
    },
    "bonus": {
      "type": "number"
    },
    "employer_cost": {
      "type": "number"
    },
    "total_cost": {
      "type": "number"
    },
    "import_id": {
      "type": "string"
    },
    "original_data": {
      "type": "string",
      "description": "Ligne du fichier source telle quelle (JSON), toutes colonnes comprises. Permet de retrouver une valeur non reconnue ou repliee sans reimporter."
    },
    "fingerprint": {
      "type": "string",
      "description": "Empreinte metier de la ligne, utilisee pour detecter les doublons entre imports."
    }
  },
  "required": [
    "employee_id",
    "period"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}