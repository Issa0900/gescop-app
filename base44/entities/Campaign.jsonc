{
  "name": "Campaign",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "campaign_name": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "enum": [
        "google_ads",
        "meta_ads",
        "instagram",
        "email",
        "tiktok",
        "linkedin",
        "youtube",
        "display",
        "web",
        "partenariat",
        "affiliation",
        "influenceurs",
        "sms",
        "print",
        "autre"
      ]
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "budget": {
      "type": "number"
    },
    "spend": {
      "type": "number"
    },
    "impressions": {
      "type": "number"
    },
    "clicks": {
      "type": "number"
    },
    "conversions": {
      "type": "number"
    },
    "revenue": {
      "type": "number"
    },
    "new_customers": {
      "type": "number"
    },
    "cac": {
      "type": "number"
    },
    "roas": {
      "type": "number"
    },
    "cpc": {
      "type": "number"
    },
    "cout_clic": {
      "type": "number"
    },
    "cost_per_click": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "terminee",
        "pause",
        "planifiee"
      ]
    },
    "import_id": {
      "type": "string"
    },
    "original_data": {
      "type": "string",
      "description": "Ligne du fichier source telle quelle (JSON), toutes colonnes comprises. Permet de retrouver une valeur non reconnue ou repliee sans reimporter."
    },
    "fingerprint": {
      "type": "string",
      "description": "Empreinte metier de la ligne, utilisee pour detecter les doublons entre imports."
    }
  },
  "required": [
    "campaign_id",
    "campaign_name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}