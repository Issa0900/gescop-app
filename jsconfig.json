{
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom"],
    "target": "esnext",
    "checkJs": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"]
  },
  "include": [
    "src/components/**/*.js", "src/components/**/*.jsx",
    "src/pages/**/*.jsx", "src/Layout.jsx",
    "src/lib/**/*.js", "src/api/**/*.js"
  ],
  "exclude": ["node_modules", "dist", "src/vite-plugins", "src/components/ui/**"]
} 